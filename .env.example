DATABASE_URL=postgresql://user:password@localhost:5432/nullvault
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional, defaults to about a year if not set. Project tokens are meant to sit in
# another codebase's environment, so they live much longer than account tokens.
PROJECT_TOKEN_EXPIRE_MINUTES=525600
ENCRYPTION_KEY=your-fernet-key-here
DB_PASSWORD=your-db-password-here
